# URL canônica, sem barra final
NEXT_PUBLIC_SITE_URL=https://advsamuelsantos.com.br

# Apenas dígitos, com DDI e DDD. O valor abaixo foi localizado no site institucional.
NEXT_PUBLIC_WHATSAPP_NUMBER=5511936249503

# URL /exec do Google Apps Script que grava na aba imovel
NEXT_PUBLIC_GOOGLE_APPS_SCRIPT_URL=https://script.google.com/macros/s/AKfycbwpPk9fLTa6fzrRvvIUmKDMRz6k7DwmEdPQhS5ADm_7--1wBNJMtWbcZIolbfCEo3KPPQ/exec

# Configure após republicar apps-script/Code.gs com suporte à aba bloqueio_conta
NEXT_PUBLIC_ACCOUNT_GOOGLE_APPS_SCRIPT_URL=

# Contatos institucionais opcionais
NEXT_PUBLIC_CONTACT_EMAIL=
NEXT_PUBLIC_OFFICE_ADDRESS=

# Indexação pública: habilite apenas no ambiente final revisado
ALLOW_INDEXING=false

# Opcional. Não use um ID fictício e não duplique uma tag já instalada.
NEXT_PUBLIC_GTM_ID=
